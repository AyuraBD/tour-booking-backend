model Event {
  id     String @id @default(uuid())
  operatorId String
  operator   Operator   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  tourId String
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate DateTime
  totalSeat Int
  availableSeat Int
  guideName String
  guidePhone String
  eventStatus EventStatus

  booking Booking[]
}

enum EventStatus{
  DRAFT
  ACTIVE
  ONGOING
  COMPLETED
}