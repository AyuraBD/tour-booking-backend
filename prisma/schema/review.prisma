model Review {
  id     String @id @default(uuid())
  tourId String
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating Int
  status ReviewStatus 
  createdAt DateTime
  title String
  comment String
  updatedAt String
}

enum ReviewStatus{
  DRAFT
  PUBLISHED
}